# Copia este archivo a .env y rellena los valores para desarrollo local.
# No subas .env a GitHub (está en .gitignore).

# URL del backend (SIN /api). La app agrega /api automáticamente.
# Ejemplos:
# - Mismo WiFi en celular físico: http://TU_IP_LOCAL:3000 (ej: http://192.168.0.25:3000)
# - Android emulador: http://10.0.2.2:3000
# - iOS simulador: http://localhost:3000
EXPO_PUBLIC_API_URL=http://192.168.0.25:3000

# Sentry DSN (público; en EAS Build se usan los secrets de EAS)
EXPO_PUBLIC_SENTRY_DSN=

# RevenueCat API Keys (Dashboard > Project > API Keys)
# Opción 1: Una sola key para ambas plataformas (desarrollo/testing)
EXPO_PUBLIC_REVENUECAT_API_KEY=test_kcIrBLYSbwizTtXedyXipapFegl
# Opción 2: Por plataforma (producción)
# EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=
# EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=

# Google AdMob App IDs (producción; si no se definen se usan IDs de prueba)
# EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-XXXXXXXX~XXXXXXXX
# EXPO_PUBLIC_ADMOB_IOS_APP_ID=ca-app-pub-XXXXXXXX~XXXXXXXX
